{
  "name": "@runmu.sh/ext-feeds",
  "version": "2.2.0",
  "description": "The Feeds panel and its routing rules: a tab per feed your rules fill (its own Settings page, per world), with unread badges, search, timestamps, pop-out, clear and built-in help.",
  "keywords": [
    "feeds",
    "rules",
    "routing",
    "spawns",
    "panel"
  ],
  "license": "MIT",
  "homepage": "https://runmu.sh/marketplace/x/feeds",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runmu-sh/ext-feeds.git"
  },
  "bugs": {
    "url": "https://github.com/runmu-sh/ext-feeds/issues"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/build.mjs --check",
    "test": "node --experimental-strip-types --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@muclient/sdk": "npm:@runmu.sh/sdk@^1.15.0",
    "@runmu.sh/dev": "^0.4.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=22.6"
  },
  "muclient": {
    "id": "feeds",
    "api": "^1.14",
    "source": "src/index.ts",
    "displayName": "Feeds",
    "description": "The Feeds panel and its routing rules: a tab per feed your rules fill (its own Settings page, per world), with unread badges, search, timestamps, pop-out, clear and built-in help.",
    "categories": [
      "interface",
      "communication"
    ],
    "contributes": {
      "panels": [
        {
          "id": "feeds",
          "title": "Feeds",
          "defaultPosition": "right-bottom",
          "order": 50,
          "show": "always"
        },
        {
          "id": "feed",
          "title": "Feed",
          "defaultPosition": "float",
          "inViewsMenu": false
        }
      ],
      "settings": {
        "title": "Feeds",
        "tile": {
          "glyph": "⇶",
          "order": 950,
          "width": "min(34rem, 94vw)"
        },
        "items": [
          {
            "key": "routes",
            "kind": "json",
            "scope": "world",
            "default": [],
            "label": "Feed routing"
          }
        ]
      }
    },
    "capabilities": [
      "read-output"
    ],
    "publisher": "bitmuse"
  }
}
